    Texture "constant3_tex" "float" "constant" "float value" [-1.0]
    Texture "bump3_tex" "float" "scale" "texture tex1" "constant3_tex" "texture tex2" "bump2_tex"  


    Texture "constant1_tex" "float" "constant" "float value" [0.15]
    Texture "glossiness2_tex" "float" "divide" "texture tex1" "constant1_tex" "texture tex2" "glossiness_tex"  
    Texture "glossiness3_tex" "float" "scale" "texture tex1" "glossiness2_tex" "texture tex2" "glossiness2_tex"  
    Texture "glossiness4_tex" "float" "scale" "texture tex1" "glossiness3_tex" "texture tex2" "glossiness3_tex"  


    Texture "constant2_tex" "color" "constant" "color value" [1.5 1.5 1.5]
    Texture "specularity2_tex" "color" "scale" "texture tex1" "constant2_tex" "texture tex2" "specularity_tex"  

        Material "substrate" 
