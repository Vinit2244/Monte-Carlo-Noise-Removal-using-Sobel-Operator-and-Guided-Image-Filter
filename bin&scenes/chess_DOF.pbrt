ObjectBegin "pawn.black.obj" 
    Translate 0.034288 0 0.08274
    Texture "diffuse_tex" "color" "imagemap" "string filename" ["textures/chess/black_pawn.diffuse0000.exr"] #"float vscale" [-1.0]
    Texture "glossiness_tex" "float" "imagemap" "string filename" ["textures/chess/black_pawn.glossiness0000.exr"] #"float vscale" [-1.0]
    Texture "specularity_tex" "color" "imagemap" "string filename" ["textures/chess/black_pawn.specularity0000.exr"] #"float vscale" [-1.0]
    Texture "bump_tex" "float" "imagemap" "string filename" ["textures/chess/black_pawn.bump0000.exr"] #"float vscale" [-1.0]




    Texture "constant4_tex" "color" "constant" "color value" [0.5 0.5 0.5]
    Texture "diffuse2_tex" "color" "scale" "texture tex1" "constant4_tex" "texture tex2" "diffuse_tex"  


    Texture "constant_tex" "float" "constant" "float value" [0]
    Texture "mixvalue_tex" "float" "constant" "float value" [0.0025]
    Texture "bump2_tex" "float" "mix" "texture tex1" "constant_tex" "texture tex2" "bump_tex" "texture amount" "mixvalue_tex"
    Texture "constant3_tex" "float" "constant" "float value" [-1.0]
    Texture "bump3_tex" "float" "scale" "texture tex1" "constant3_tex" "texture tex2" "bump2_tex"  


    Texture "constant1_tex" "float" "constant" "float value" [0.15]
    Texture "glossiness2_tex" "float" "divide" "texture tex1" "constant1_tex" "texture tex2" "glossiness_tex"  
    Texture "glossiness3_tex" "float" "scale" "texture tex1" "glossiness2_tex" "texture tex2" "glossiness2_tex"  
    Texture "glossiness4_tex" "float" "scale" "texture tex1" "glossiness3_tex" "texture tex2" "glossiness3_tex"  


    Texture "constant2_tex" "color" "constant" "color value" [1.5 1.5 1.5]
    Texture "specularity2_tex" "color" "scale" "texture tex1" "constant2_tex" "texture tex2" "specularity_tex"  

        Material "substrate" 
    "texture Kd" "diffuse_tex" 
    "texture Ks" "specularity2_tex" 
    "texture uroughness" "glossiness4_tex" 
    "texture vroughness" "glossiness4_tex" 
    "texture bumpmap" "bump3_tex"

    Shape "wavefront" "string filename" ["geometry/chess/black_pawn3.obj"]
ObjectEnd
