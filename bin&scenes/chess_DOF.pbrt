ObjectBegin "bishop1.white.obj"
    Texture "constant_tex" "color" "constant" "color value" [.9 .9 .9]
        #Material "matte" "color Kd" [.9 .9 .9]
        Material "plastic" "texture Kd" "constant_tex"
    Shape "wavefront" "string filename" ["geometry/chess/bishop1.white.obj"]
ObjectEnd
