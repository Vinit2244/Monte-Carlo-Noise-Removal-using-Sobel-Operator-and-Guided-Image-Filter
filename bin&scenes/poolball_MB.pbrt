Film "image" 
"integer xresolution" [1024] 
"integer yresolution" [1024]
"float scale" [2]
"float gamma" [0.5]

Sampler "lowdiscrepancy"

LookAt 0 300 0    0 0 -5  0 0 1
Camera "perspective" "float fov" [14] 

WorldBegin

LightSource "distant" "point from" [-0.1 0.1 1.2] "color L" [1 1 1]
LightSource "distant" "point from" [0.186190 0.514521 0.549444] "color L" [.3210 .2306 .2919]
LightSource "distant" "point from" [0.371649 0.768631 0.227653] "color L" [.3826 .3689 .3754]
LightSource "distant" "point from" [0.470249 0.882291 0.320696] "color L" [.18881 .26806 .32420]
LightSource "distant" "point from" [-0.442861 0.968631 0.222155] "color L" [.23466 .19180 .21958]
LightSource "distant" "point from" [0.412283 0.800362 0.205511] "color L" [.35678 .24086 .23976]
LightSource "distant" "point from" [0.550536 0.971044 0.347821] "color L" [.53103 .46485 .56109]
LightSource "distant" "point from" [-0.151671 0.911743 0.113032] "color L" [.71312 .884649 .80156]
LightSource "distant" "point from" [-0.269034 0.868833 0.248217] "color L" [.36443 .32189 .33331]


LightSource "distant" "point from" [0.470249 -0.882291 -0.320696] "color L" [1 1 1]
LightSource "distant" "point from" [-0.442861 -0.968631 -0.222155] "color L" [1 1 1]
LightSource "distant" "point from" [0.412283 0.800362 0.205511] "color L" [1 1 1]
LightSource "distant" "point from" [0.550536 0.971044 0.347821] "color L" [1 1 1]





AttributeBegin
	Translate 0 0 -40
	Scale -0.1 0.1 0.1
	#Translate 0 0 100
   	Material "plastic" "color Kd" [.9 .9 .7] "color Ks" [1 1 1] "float roughness" [.005]
	ActiveTransform EndTime
			Translate 0 0 200
	#ActiveTransform EndTime
	AttributeBegin
		ObjectBegin "ballw"
			Shape "wavefront" "string filename" ["geometry/poolball/ball.obj"]
		ObjectEnd
	AttributeEnd
AttributeEnd




AttributeBegin
	Texture "number1" "color" "imagemap" "string filename" ["textures/poolball/5.exr"] "float uscale" [-1]
	Material "plastic" "texture Kd" "number1" "color Ks" [1 1 1] "float roughness" [.005] 

	Translate 15 0 -10
	
	#Rotate 90 1 0 0
	Scale -0.1 0.1 0.1
	ActiveTransform EndTime	
	Translate -50 0 50
	
	AttributeBegin
		ObjectBegin "ball1"
			Shape "wavefront" "string filename" ["geometry/poolball/ball.obj"]
		ObjectEnd
	AttributeEnd
AttributeEnd

AttributeBegin
	Translate -25 0 13
	Rotate 90 1 0 0
	Rotate -35 1 4 1
	Scale -0.1 0.1 0.1
	Texture "number2" "color" "imagemap" "string filename" ["textures/poolball/2.exr"] "float uscale" [-1]
   	Material "plastic" "texture Kd" "number2" "color Ks" [1 1 1] "float roughness" [.005] 
	#ActiveTransform EndTime
	#		Translate 0 0 -10
	AttributeBegin
		ObjectBegin "ball2"
			Shape "wavefront" "string filename" ["geometry/poolball/ball.obj"]
		ObjectEnd
	AttributeEnd
AttributeEnd

AttributeBegin
	Translate 3 0 8
	Rotate 90 1 0 0
	Rotate 12 1 5 1
	Scale -0.1 0.1 0.1
	Texture "number2" "color" "imagemap" "string filename" ["textures/poolball/8.exr"] "float uscale" [-1]
	Material "plastic" "texture Kd" "number2" "color Ks" [1 1 1] "float roughness" [.005] 
	#AttributeBegin
	#ActiveTransform StartTime 0.0
	#	Rotate 10 -6 0 -4
	#	Translate 40 40 0
	#ActiveTransform EndTime 1.0
	#AttributeEnd
	AttributeBegin
		ObjectBegin "ball3"
			Shape "wavefront" "string filename" ["geometry/poolball/ball.obj"]
		ObjectEnd
	AttributeEnd
AttributeEnd



AttributeBegin
	Translate 20 0 20
	Rotate 90 1 0 0
	Rotate -35 1 4 1
	Scale -0.1 0.1 0.1
	Texture "number2" "color" "imagemap" "string filename" ["textures/poolball/1.exr"] "float uscale" [-1]
   	Material "plastic" "texture Kd" "number2" "color Ks" [1 1 1] "float roughness" [.005]
	AttributeBegin
		ObjectBegin "ball4"
			Shape "wavefront" "string filename" ["geometry/poolball/ball.obj"]
		ObjectEnd
	AttributeEnd
AttributeEnd

ObjectBegin "table"
	Scale 0.1 0.1 0.1
    	#Material "matte" "color Kd" [.1 .25 .1] 
	Texture "tabletex" "color" "imagemap" "string filename" ["textures/poolball/table.exr"] "float vscale" [2] "float uscale" [2]
	#Texture "tabletex" "color" "imagemap" "string filename" ["textures/poolball/table.exr"] "float vscale" [1.5] "float uscale" [1.5]
    	Material "matte" "texture Kd" "tabletex" 
	Shape "wavefront" "string filename" ["geometry/poolball/table.obj"]
ObjectEnd

ObjectBegin "wood"
	Scale 0.1 0.1 0.1
    	Material "plastic" "color Kd" [.16 .13 .05] "color Ks" [1 1 1] "float roughness" [.05] 
	Shape "wavefront" "string filename" ["geometry/poolball/wood.obj"]
ObjectEnd

ObjectBegin "background"
	Scale 0.1 0.1 0.1
    	Material "matte" "color Kd" [.75 .75 .5]
	Shape "wavefront" "string filename" ["geometry/poolball/back.obj"]
ObjectEnd

ObjectBegin "hole"
	Scale 0.1 0.1 0.1
    	Material "matte" "color Kd" [.01 .01 .01]
	Shape "wavefront" "string filename" ["geometry/poolball/hole.obj"]
ObjectEnd

Translate 5 0 5

AttributeBegin
ObjectInstance "ballw"
AttributeEnd

AttributeBegin
ObjectInstance "ball1"
AttributeEnd

ObjectInstance "ball2"

AttributeBegin
ObjectInstance "ball3"
AttributeEnd

AttributeBegin
ObjectInstance "ball4"
AttributeEnd

ObjectInstance "table"
ObjectInstance "wood"
ObjectInstance "hole"



WorldEnd